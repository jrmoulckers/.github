{
  "$comment": "JRM Studio manifest. Source of truth for the cross-repo sync engine in sync/ (see docs/sync.md and sync/README.md), which reads this file on every run.",
  "studio": "JRM Studio",
  "owner": "jrmoulckers",
  "ownerType": "user",
  "npmScope": "@jrm",
  "backbone": "jrmoulckers/.github",
  "version": 1,
  "canon": {
    "base": ["AGENTS.md", "agency.toml"],
    "agents": [
      "accessibility-reviewer",
      "ai-ops-engineer",
      "architect",
      "backend-engineer",
      "business-analyst",
      "compliance-specialist",
      "data-engineer",
      "design-engineer",
      "devops-engineer",
      "docs-writer",
      "experimentation-engineer",
      "localization-engineer",
      "marketing-strategist",
      "performance-engineer",
      "product-manager",
      "qa-tester",
      "release-manager",
      "security-reviewer",
      "web-engineer"
    ],
    "skills": [
      "accessibility-testing",
      "design-tokens",
      "dev-onboarding",
      "go-to-market",
      "i18n-localization",
      "issue-management",
      "mcp-agent-tooling",
      "monetization",
      "performance-budgets",
      "privacy-compliance",
      "project-management",
      "prompt-engineering",
      "security-review-methodology",
      "sprint-planning",
      "ux-testing"
    ],
    "prompts": ["backlog", "cleanup", "fix-ci", "rebase-all", "review", "sprint", "team"],
    "instructions": ["agents", "docs", "skills", "tokens", "workflow"],
    "workflows": [
      "reusable-ci-lint",
      "reusable-ci-web",
      "reusable-deploy-preview",
      "reusable-perf-budget",
      "reusable-smoke-test"
    ],
    "health": [
      "CONTRIBUTING.md",
      "SECURITY.md",
      "CODE_OF_CONDUCT.md",
      ".github/PULL_REQUEST_TEMPLATE.md",
      ".github/ISSUE_TEMPLATE",
      ".github/DISCUSSION_TEMPLATE"
    ],
    "profile": ["profile/README.md"]
  },
  "sourcePaths": {
    "base": ".",
    "agents": "agents",
    "skills": "skills",
    "prompts": "prompts",
    "instructions": "instructions",
    "workflows": ".github/workflows",
    "health": ".",
    "profile": "profile"
  },
  "targetPaths": {
    "base": ".",
    "agents": ".github/agents",
    "skills": ".github/skills",
    "prompts": ".github/prompts",
    "instructions": ".github/instructions",
    "workflows": ".github/workflows",
    "health": "native",
    "profile": "profile"
  },
  "optInSyntax": {
    "$comment": "Each member.optIn.<kind> is either the string \"*\" (all canon of that kind), an array of names, or false (opt out). base/health are booleans.",
    "kinds": ["base", "agents", "skills", "prompts", "instructions", "workflows", "health"]
  },
  "tokens": {
    "$comment": "Vendored design tokens from the OTHER private backbone repo jrmoulckers/studio (package @jrm/tokens). Registry-free: the sync engine copies studio's committed dist/ tree verbatim into each opted-in member (Option A). The whole sourceBase tree is mirrored today; a future optional per-member `include` (array of sub-globs under sourceBase) may narrow this without a breaking schema change. Per-member opt-in lives in members[].tokens, kept separate from optIn because the source is an external repo, not the .github canon.",
    "sourceRepo": "jrmoulckers/studio",
    "package": "@jrm/tokens",
    "sourceBase": "packages/tokens/dist",
    "targetPath": "vendor/@jrm/tokens"
  },
  "members": [
    {
      "repo": "jrmoulckers/jrm-recipes",
      "framework": "nextjs",
      "packageManager": "pnpm",
      "notes": "New consumer web product. Adopts the full canonical layer.",
      "optIn": {
        "base": true,
        "health": true,
        "agents": "*",
        "skills": "*",
        "prompts": "*",
        "instructions": "*",
        "workflows": ["reusable-ci-lint", "reusable-ci-web", "reusable-deploy-preview", "reusable-perf-budget"]
      },
      "tokens": { "enabled": false }
    },
    {
      "repo": "jrmoulckers/score-king",
      "framework": "svelte",
      "packageManager": "npm",
      "notes": "Game-night scoring app; already carries committed design context. Adopts most of the layer; keeps its own design-engineer locally.",
      "optIn": {
        "base": true,
        "health": true,
        "agents": [
          "architect",
          "web-engineer",
          "devops-engineer",
          "qa-tester",
          "security-reviewer",
          "accessibility-reviewer",
          "docs-writer",
          "product-manager",
          "release-manager",
          "performance-engineer"
        ],
        "skills": [
          "accessibility-testing",
          "design-tokens",
          "performance-budgets",
          "ux-testing",
          "issue-management",
          "project-management",
          "sprint-planning",
          "prompt-engineering"
        ],
        "prompts": ["review", "fix-ci", "cleanup", "backlog", "sprint"],
        "instructions": ["workflow", "agents", "skills", "docs", "tokens"],
        "workflows": ["reusable-ci-lint", "reusable-ci-web", "reusable-deploy-preview", "reusable-perf-budget"]
      },
      "tokens": { "enabled": false }
    },
    {
      "repo": "jrmoulckers/finance",
      "framework": "kmp-web",
      "packageManager": "npm",
      "notes": "Origin of most canon; maintains its own richer, product-specific AI layer. Consumes shared health + reusable workflows only.",
      "optIn": {
        "base": true,
        "health": true,
        "agents": false,
        "skills": false,
        "prompts": false,
        "instructions": false,
        "workflows": ["reusable-ci-lint", "reusable-smoke-test"]
      },
      "tokens": { "enabled": true, "targetPath": "apps/web/vendor/@jrm/tokens" }
    },
    {
      "repo": "jrmoulckers/libro",
      "framework": "svelte",
      "packageManager": "pnpm",
      "notes": "Pure-client media hub for books and audiobooks. Svelte/Vite PWA at repo root; first member to consume vendored @jrm/tokens.",
      "optIn": {
        "base": true,
        "health": true,
        "agents": "*",
        "skills": "*",
        "prompts": "*",
        "instructions": "*",
        "workflows": ["reusable-ci-lint", "reusable-ci-web", "reusable-deploy-preview", "reusable-perf-budget"]
      },
      "tokens": { "enabled": true }
    },
    {
      "repo": "jrmoulckers/cartridge",
      "framework": "nextjs",
      "packageManager": "pnpm",
      "notes": "Game-library aggregator across Steam/Xbox/PlayStation/Nintendo. Next.js App Router at repo root; needs a first-party server tier because every ingestion path uses third-party credentials.",
      "optIn": {
        "base": true,
        "health": true,
        "agents": "*",
        "skills": "*",
        "prompts": "*",
        "instructions": "*",
        "workflows": ["reusable-ci-lint", "reusable-ci-web", "reusable-deploy-preview", "reusable-perf-budget"]
      },
      "tokens": { "enabled": true }
    }
  ]
}
